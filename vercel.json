{
  "version": 2,
  "name": "nagara-intelligence-hub",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "office/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/portfolio-data.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/quote-calc.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/sales-ui.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/hari-ini.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/produksi-ui.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/konten.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/desain-ui.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "kb/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/inbox/send",
      "dest": "/api/inbox/send.js"
    },
    {
      "src": "/api/inbox/webhook-wa",
      "dest": "/api/inbox/webhook-wa.js"
    },
    {
      "src": "/api/inbox/send-email",
      "dest": "/api/inbox/send-email.js"
    },
    {
      "src": "/api/inbox/ai-draft",
      "dest": "/api/inbox/ai-draft.js"
    },
    {
      "src": "/api/airtable/proxy",
      "dest": "/api/airtable/proxy.js"
    },
    {
      "src": "/api/openwa/proxy",
      "dest": "/api/openwa/proxy.js"
    },
    {
      "src": "/api/robot/signal",
      "dest": "/api/robot/signal.js"
    },
    {
      "src": "/api/inbox/webhook-openwa",
      "dest": "/api/inbox/webhook-openwa.js"
    },
    {
      "src": "/api/auth/(login|logout|me)",
      "dest": "/api/auth.js?action=$1"
    },
    {
      "src": "/api/office/(state|leads|leads-sync|lead|approval|conversations|wa-inbound|quote-settings|quotes|quote|tickets|ticket|quote-view|nadi-progress|hari-ini|putuskan|produksi|konten|desain-aset|desain-aksi|desain)",
      "dest": "/api/office/state.js?action=$1"
    },
    {
      "src": "/api/agents/(arah|usul|rawat)",
      "dest": "/api/agents/run.js?agent=$1"
    },
    {
      "src": "/api/(.*)\\.js",
      "dest": "/api/$1.js"
    },
    {
      "src": "/js/portfolio-data.js",
      "dest": "/js/portfolio-data.js"
    },
    {
      "src": "/js/quote-calc.js",
      "dest": "/js/quote-calc.js"
    },
    {
      "src": "/js/sales-ui.js",
      "dest": "/js/sales-ui.js"
    },
    {
      "src": "/js/hari-ini.js",
      "dest": "/js/hari-ini.js"
    },
    {
      "src": "/js/konten.js",
      "dest": "/js/konten.js"
    },
    {
      "src": "/js/produksi-ui.js",
      "dest": "/js/produksi-ui.js"
    },
    {
      "src": "/js/desain-ui.js",
      "dest": "/js/desain-ui.js"
    },
    {
      "src": "/office/?",
      "dest": "/office/index.html"
    },
    {
      "src": "/office/(.*)",
      "dest": "/office/$1"
    },
    {
      "src": "/penawaran/([a-f0-9]{64})/?",
      "dest": "/api/office/state.js?action=quote-view&t=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/agents/arah",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/agents/arah",
      "schedule": "0 10 * * *"
    }
  ]
}
